# Server host and port
HOST=0.0.0.0
PORT=4173

# Optional token. Set this in production.
APP_TOKEN=change-me

# Optional codex binary path. Leave "codex" if available in PATH.
CODEX_BIN=codex

# Optional GitHub profile URL shown as quick link in header.
# If empty, server tries to auto-detect from git remote.
GITHUB_PROFILE_URL=https://github.com/JMittelbach

# Default folder shown in the UI
DEFAULT_CWD=/Users/jannes/Github

# Comma-separated roots allowed for run cwd
ALLOWED_ROOTS=/Users/jannes/Github

# VS Code chat mirror (read-only import)
VSCODE_MIRROR_ENABLED=1
VSCODE_MIRROR_SCAN_MS=3000
VSCODE_MIRROR_MAX_FILES=300
# Optional custom roots:
# VSCODE_MIRROR_ROOTS=/Users/jannes/Library/Application Support/Code/User/workspaceStorage

# Codex session mirror from ~/.codex/sessions (continuable from mobile)
CODEX_SESSION_MIRROR_ENABLED=1
CODEX_SESSION_MIRROR_MAX_FILES=120

# Codex app-server live threads (all sessions + approvals in web app)
APP_SERVER_ENABLED=1
APP_SERVER_SYNC_MS=5000
APP_SERVER_THREAD_LIMIT=200
APP_SERVER_REQUEST_TIMEOUT_MS=25000

# File browser limits
BROWSE_MAX_ENTRIES=400
BROWSE_MAX_FILE_BYTES=160000
# Optional custom browse roots:
# BROWSE_ROOTS=/Users/jannes/Github,/Users/jannes/.codex,/Users/jannes/Library/Application Support/Code/User
