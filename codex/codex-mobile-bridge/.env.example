# Server host and port
HOST=0.0.0.0
PORT=4173

# Optional token. Set this in production.
APP_TOKEN=change-me

# Optional codex binary path. Leave "codex" if available in PATH.
CODEX_BIN=codex

# Default folder shown in the UI
DEFAULT_CWD=/Users/jannes/Github

# Comma-separated roots allowed for run cwd
ALLOWED_ROOTS=/Users/jannes/Github

# VS Code chat mirror (read-only import)
VSCODE_MIRROR_ENABLED=1
VSCODE_MIRROR_SCAN_MS=3000
VSCODE_MIRROR_MAX_FILES=300
# Optional custom roots:
# VSCODE_MIRROR_ROOTS=/Users/jannes/Library/Application Support/Code/User/workspaceStorage
